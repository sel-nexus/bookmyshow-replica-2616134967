# HTTP port for the Express API.
PORT=4000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
# File-backed SQLite database path.
DATABASE_PATH=./data/bookmyshow.sqlite
# HS256 signing secret; replace this local value in deployed environments.
JWT_SECRET=bookmyshow-local-auth-secret-2026
# Token issuer claim.
JWT_ISSUER=bookmyshow-replica
# Token audience claim.
JWT_AUDIENCE=bookmyshow-web
